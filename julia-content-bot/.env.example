# Chave da API do Claude (Anthropic)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Chave pública do Trello
# Obtenha em: https://trello.com/power-ups/admin → criar Power-Up → API Key
TRELLO_API_KEY=...

# Token de acesso do Trello
# Depois de pegar a Key, acesse: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=SUA_KEY_AQUI
TRELLO_TOKEN=...

# ID do quadro do Trello onde os cards serão criados
# Abra o quadro no Trello, adicione .json ao final da URL e copie o "id"
TRELLO_BOARD_ID=...
